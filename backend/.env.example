# Copy to .env for local (non-Docker) development
DATABASE_URL=postgresql://boardly:boardly@localhost:5439/boardly
SECRET_KEY=dev-secret-change-me
APP_ENV=development
FLASK_APP=wsgi.py

# --- Production ---
# APP_ENV=production
# SECRET_KEY=<random, 32+ chars — the app refuses to start without it>
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>
# TRUST_PROXY=1   # behind a reverse proxy, so rate limits see client IPs
# CORS_ORIGINS=https://play.example.com   # web app's address(es), comma-separated
