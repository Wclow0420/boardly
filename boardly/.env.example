# Copy to .env.local for local development (never committed).
# Cloud builds do not read this file: set the same variable per
# environment on expo.dev → Project → Environment variables, or pull
# those values down with `eas env:pull --environment development`.

# Where the Boardly backend lives. On a real phone use your computer's
# LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:5005
